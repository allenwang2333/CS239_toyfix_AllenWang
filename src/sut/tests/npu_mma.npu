; machine: npu-base
; mm, mma, vrelu, vsub, and vmul (spec §3).
.data 12
.word 0, 1, 2, 3, 4         ; A = [[1, 2], [3, 4]]
.word 4, 5, -6, 7, -8       ; B = [[5, -6], [7, -8]]
  load 0, 0, 2, 2, 2, 1     ; spad[0..3] = A
  load 4, 4, 2, 2, 2, 1     ; spad[4..7] = B
  mm 8, 0, 4, 2, 2, 2       ; spad[8..11] = A @ B = 19 -22 43 -50
  mma 8, 0, 4, 2, 2, 2      ; spad[8..11] += A @ B
  store 8, 8, 2, 2, 2
  out 8, 2, 2, 2, 1         ; 38 -44 / 86 -100
  vrelu 8, 8, 4             ; 38 0 86 0
  vsub 8, 8, 0, 4           ; 37 -2 83 -4
  vmul 8, 8, 4, 4           ; 185 12 581 32
  store 8, 8, 2, 2, 2
  out 8, 1, 4, 1, 1

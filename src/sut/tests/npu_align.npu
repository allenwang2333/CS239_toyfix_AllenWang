; machine: npu-base
; Only the DRAM address of load and store must be a multiple of dma_align.
; Scratchpad addresses and out addresses need no alignment (spec §4.4(f)).
.data 8
.word 4, 6, 7
  load 3, 4, 1, 2, 0, 1     ; spad[3..4] = 6 7
  vmul 5, 3, 3, 2           ; spad[5..6] = 36 49
  store 0, 5, 1, 2, 0
  out 0, 1, 2, 0, 1         ; 36 49
  out 3, 1, 3, 0, 1         ; 0 6 7
